<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    tools:context=".EventInfoPopup">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_yellow_card"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:scrollbarSize="8dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbarThumbVertical="@drawable/bg_scrollbar_thumb"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <!-- Close Button -->
                <TextView
                    android:id="@+id/btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/intel_one_mono"
                    android:padding="8dp"
                    android:text="@string/close"
                    android:textColor="@color/black"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Event Name -->
                <TextView
                    android:id="@+id/tv_eventName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="EVENT NAME"
                    android:textColor="@color/black"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Category Badge -->
                <TextView
                    android:id="@+id/tv_categoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:text="CLUB"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Location -->
                <TextView
                    android:id="@+id/tv_eventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Location"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />

                <!-- Until / End Time -->
                <TextView
                    android:id="@+id/tv_eventEndTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Until: --:--"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Divider -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@color/black" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_eventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Description goes here..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText" />

                <!-- Photo Preview -->
                <ImageView
                    android:id="@+id/iv_eventImage"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@string/photo_label"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Posted By Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Posted By:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Posted By Author Name (Clickable link if org) -->
                <TextView
                    android:id="@+id/tv_postedByName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Author Name"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Is the event here?: -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="Is the event here?:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- YES / NO Voting Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/btn_voteYes"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_login_button"
                        android:fontFamily="@font/intel_one_mono"
                        android:text="YES"
                        android:textColor="@color/bright_yellow"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <android.widget.Button
                        android:id="@+id/btn_voteNo"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_login_button"
                        android:fontFamily="@font/intel_one_mono"
                        android:text="NO"
                        android:textColor="@color/bright_yellow"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- REPORT Button -->
                <android.widget.Button
                    android:id="@+id/btn_reportEvent"
                    android:layout_width="180dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_report_button"
                    android:fontFamily="@font/intel_one_mono"
                    android:text="REPORT"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>
</FrameLayout>